# Copiar a .env:  cp .env.example .env
#
# Mismo nombre que en app/core/environment.py (settings.DB_HOST ...), mismas secciones y orden.
# - Variables sin comentar: revisar en cada proyecto y entorno (cambian entre dev/staging/prod o
#   deben coincidir con la infraestructura: nginx, base de datos, workers).
# - Variables comentadas (# VAR=valor): OPCIONALES, el valor mostrado es el default seguro.
#   Descomentar solo para cambiarlo. Una variable vacía (VAR=) también usa el default.
# - Los comentarios van en su propia línea (no al final del valor).
# - Otro archivo: ENV_FILE=/ruta/.env como variable del proceso (vacío = no leer ninguno).

# ======= Application ======= #
# Obligatorio: development | test | staging | production
APP_ENV=development
APP_NAME="FastAPI Project"
# Reservado para la auth del proyecto (el template aún no lo usa).
# En producción: mínimo 32 caracteres. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=


# ======= Logger ======= #
LOGGER_LEVEL=INFO
# text | json (json para Loki/ELK/Datadog)
LOG_FORMAT=text
LOGGER_MIDDLEWARE_ENABLED=True
# Authorization/Cookie y headers sensibles siempre se enmascaran
# LOGGER_MIDDLEWARE_SHOW_HEADERS=False
# LOGGER_MIDDLEWARE_SHOW_QUERY_PARAMS=True
# True = path real (/users/15), False = plantilla (/users/{user_id})
# LOGGER_MIDDLEWARE_SHOW_PATH_PARAMS=True
# True = solo registra requests con error (4xx/5xx)
LOGGER_MIDDLEWARE_ERRORS_ONLY=False
# Registrar también los errores controlados 4xx (los 5xx siempre se registran)
LOGGER_EXCEPTIONS_ENABLED=False


# ======= Docs (/api/v1/docs, /api/v1/redoc) ======= #
# True en desarrollo; en producción False (o True con DOCS_PASSWORD_ENABLED).
# Sin definir = habilitado fuera de producción, deshabilitado en producción
DOCS_ENABLED=True
# Si True, docs requieren HTTP Basic Auth (en staging y producción: password ≥ 12 caracteres)
DOCS_PASSWORD_ENABLED=False
DOCS_USER=admin
DOCS_PASSWORD=


# ======= Rate limiting ======= #
# El límite global por IP lo aplica nginx (limit_req). En la app: rate_limit() por ruta.
RATE_LIMIT_ENABLED=True
# Límite de ejemplo para login/registro. Formato: {n}/{second|minute|hour|day}
RATE_LIMIT_LOGIN=5/minute
# False = contadores en memoria de cada worker. True = Redis compartido
# (requiere: uv sync --extra redis; cliente redis-py)
# RATE_LIMIT_REDIS_ENABLED=False
# RATE_LIMIT_REDIS_URL=redis://localhost:6379
# Número de workers de uvicorn (lo lee el entrypoint de Docker, no la app)
WORKERS=1


# ======= Pagination / Request / Uploads ======= #
# Máximo por página (hard cap en código: 200)
PAGINATION_MAX_SIZE=50
# Tamaño máximo del body (POST/PUT/PATCH). Mantener igual a client_max_body_size de nginx
REQUEST_MAX_SIZE_MB=10
# Carpeta temporal de uploads (relativa a la raíz del proyecto o absoluta)
# UPLOAD_DIR=uploads


# ======= CORS ======= #
# Orígenes separados por coma. Vacío = CORS deshabilitado.
# "*" desactiva credenciales y está prohibido en producción.
CORS_ORIGINS=http://localhost:3000
# Permite cookies/Authorization cross-origin (se ignora si CORS_ORIGINS=*)
# CORS_ALLOW_CREDENTIALS=True


# ======= Database (MariaDB / MySQL) ======= #
DB_HOST=localhost
DB_PORT=3306
DB_USER=app
DB_PASS=
DB_NAME=app
# Collation de la sesión: debe coincidir con la de la base/tablas (evita "Illegal mix of collations")
DB_COLLATION=utf8mb4_unicode_ci
# Pool por worker. Regla: WORKERS × (DB_POOL_SIZE + DB_MAX_OVERFLOW) × réplicas < max_connections
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
# Segundos esperando una conexión libre antes de responder 503 (fallar rápido)
# DB_POOL_TIMEOUT=3
# Reciclar conexiones cada N segundos (debe ser < wait_timeout del servidor)
# DB_POOL_RECYCLE=180
# DB_CONNECT_TIMEOUT=5
# Tiempo máximo por sentencia en el servidor, en segundos (0 = sin límite).
# MariaDB: max_statement_time (no aplica dentro de SP). MySQL: MAX_EXECUTION_TIME (solo SELECT)
DB_STATEMENT_TIMEOUT=30


# ======= Security ======= #
# Llaves Fernet separadas por coma: la primera cifra, todas descifran (rotación: agregar la
# nueva al inicio). Cifran contraseñas y datos sensibles: guardarlas y respaldarlas APARTE del
# backup de la BD. Obligatorio en staging/producción; vacío en dev = llave temporal. Generar con:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEYS=
# Alfabeto de los IDs públicos (sqids). Propio por proyecto y fijo para siempre (cambiarlo
# invalida los IDs ya compartidos). En producción no puede ser el default. Generar con:
#   uv run python -c "import random, string; a = list(string.ascii_letters + string.digits); random.shuffle(a); print(''.join(a))"
ENCODING_ALPHABET=
# Longitud mínima de los IDs públicos
# ENCODING_MIN_LENGTH=8


# ======= HTTP client (servicios externos) ======= #
# Valores por defecto de cada servicio (app/services/*_service.py puede definir los suyos)
# HTTP_CLIENT_TIMEOUT=10
# HTTP_CLIENT_CONNECT_TIMEOUT=5
# Espera máxima por una conexión libre del pool del servicio antes de responder 503
# HTTP_CLIENT_POOL_TIMEOUT=2
# Conexiones máximas por servicio externo (cada servicio tiene su propio pool)
# HTTP_CLIENT_MAX_CONNECTIONS=20
# Reintentos solo en métodos idempotentes (GET/PUT/DELETE...) ante fallos transitorios
# HTTP_CLIENT_MAX_RETRIES=2


# ======= Observabilidad ======= #
# Telemetría nativa de FastAPI (OpenTelemetry). Exporta solo si se define
# OTEL_EXPORTER_OTLP_ENDPOINT (ej. http://otel-collector:4318)
# OTEL_ENABLED=True
